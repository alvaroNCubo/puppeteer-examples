<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Tetris.Acting</RootNamespace>
    <AssemblyName>TetrisActor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\domain\TetrisDomain.csproj" />

    <!--
      Engine reference — the Puppeteer Pacifico MAIN checkout (master). As of
      2026-07-01 the OutputTarget push API (IOutputSink / PushDocument /
      PerformanceV2.OutputTarget) AND the InputSource seam are merged to master,
      so the earlier `feature/outputtarget-push` worktree reference is retired
      (that worktree has been removed). The example assemblies stay unsigned; an
      unsigned assembly may reference the signed engine assemblies, so this builds.

      Next progression step: once synced to the public clone (and Choreography
      de-signed there), point at the HelloWorld convention:
        ..\..\..\puppeteer\Puppeteer|Choreography\*.csproj
    -->
    <!--
      MINIMUM ENGINE: master at or after dd67047. Three fixes this example's
      redecomp lab surfaced and depends on:
        e65f681  automatic Script-to-Action promotion removed. It rewrote a repeated
                 command's literals into generated parameters and consumed the `expose`
                 ALIAS with them, so SplitTetrisActor's landing choreography silently
                 stopped firing after the tenth landing.
        036b972  a stale persisted sparse index no longer hides a journal's tail; before
                 it, a record read back short past ~100 entries.
        dd67047  a zero-argument invocation is replayable; before it, rehydrating a
                 promoted nullary Action logged and skipped those acts.
      To check, run `git merge-base` with the is-ancestor flag for dd67047 against that
      checkout's HEAD. See Tetris/notes/redecomposition-pile-and-piece.md §8 and §9.
    -->
    <!-- p9/labg-rerun: pointed at a dedicated worktree pinned to master dd67047,
         so the re-run does not depend on the shared checkout's branch. -->
    <ProjectReference Include="..\..\..\eng\Puppeteer\Puppeteer.csproj" />
    <ProjectReference Include="..\..\..\eng\Choreography\Choreography.csproj" />
  </ItemGroup>

</Project>
